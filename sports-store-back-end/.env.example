# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
# macOS note: port 5000 is taken by AirPlay Receiver (ControlCenter) —
# use 5001 and set the frontend's VITE_API_URL to match.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sports_store
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Allowed frontend origin(s). Must match where the Vite dev server runs
# (Vite default is http://localhost:5173).
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Public base URL the seed uses to build absolute product-image URLs
# (images are served by the API at /images). Keep in sync with PORT.
PUBLIC_BASE_URL=http://localhost:5001
